{
	"version": "0.2.0",
	"compounds": [
		{
			"name": "Extension + LSP",
			"configurations": [
				"Launch Extension",
				"C#: QuickMarkup.LanguageServer"
			]
		}
	],
	"configurations": [
		{
			"name": "Launch Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/QuickMarkup.VSCode.Extension"
			],
			"env": {
				"QMUI_LSP_DEBUG": "8765"
			},
			"preLaunchTask": "[extension] npm: watch"
		},
		{
			"name": "Launch Extension (Built Assembly)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/QuickMarkup.VSCode.Extension"
			],
			"preLaunchTask": "[extension] npm: watch"
		},
		{
			"name": "C#: QuickMarkup.LanguageServer",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}\\QuickMarkup.LanguageServer\\QuickMarkup.LanguageServer.csproj",
			"launchConfigurationId": "TargetFramework=;QuickMarkup.LanguageServer"
		}
	]
}