<Project>
  <PropertyGroup>
    <RootNamespace>QuickMarkup.WinUI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en-US</DefaultLanguage>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <Description>QuickMarkup WinUI helpers</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\QuickMarkup.Infra\QuickMarkup.Infra.csproj" />
  </ItemGroup>
  <Import Project="..\QuickMarkup.Nuget.props" />
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Compile Include="..\QuickMarkup.Win\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\Get.Layout\obj\**\*" />
    <Page Include="..\QuickMarkup.Win\**\*.xaml" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\Get.Layout\obj\**\*" />
  </ItemGroup>
</Project>
