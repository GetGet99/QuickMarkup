{
  "name": "quickmarkup-lsp",
  "displayName": "QuickMarkup LSP",
  "description": "QuickMarkup language support with real-time diagnostics",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:quickmarkup"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "quickmarkup",
        "extensions": [".qmui"],
        "aliases": ["QuickMarkup", "quickmarkup"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quickmarkup",
        "scopeName": "source.quickmarkup",
        "path": "./syntaxes/qmui.tmGrammar.json",
        "embeddedLanguages": {
          "meta.embedded.csharp": "csharp"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "gen:textmate": "dotnet run --project ../QuickMarkup.GrammarGenerator/QuickMarkup.GrammarGenerator.csproj"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
