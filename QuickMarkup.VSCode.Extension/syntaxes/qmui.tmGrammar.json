{
  "scopeName": "source.quickmarkup",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "name": "keyword.import",
          "match": "using"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bprivate\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bpublic\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bstatic\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bset\\b"
        },
        {
          "name": "constant.language.boolean",
          "match": "true"
        },
        {
          "name": "constant.language.boolean",
          "match": "false"
        },
        {
          "name": "constant.language.boolean",
          "match": "null"
        },
        {
          "name": "constant.language.boolean",
          "match": "default"
        },
        {
          "name": "keyword.other",
          "match": "\\bref\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bnamespace\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bclass\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bcomponent\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\bfragment\\b"
        },
        {
          "name": "keyword.control",
          "match": "\\bvar\\b"
        },
        {
          "name": "keyword.control",
          "match": "\\bforeach\\b"
        },
        {
          "name": "keyword.control",
          "match": "\\bif\\b"
        },
        {
          "name": "keyword.control",
          "match": "\\belse\\b"
        },
        {
          "name": "keyword.control",
          "match": "\\bin\\b"
        },
        {
          "name": "keyword.operator.assignment",
          "match": "="
        },
        {
          "name": "keyword.operator.assignment",
          "match": "=\u003E"
        },
        {
          "name": "keyword.operator.comparison",
          "match": "\u003C=\u003E"
        },
        {
          "name": "keyword.operator.assignment",
          "match": "\\\u002B="
        },
        {
          "name": "punctuation.separator.comma",
          "match": ","
        },
        {
          "name": "punctuation.bracket",
          "match": "\\["
        },
        {
          "name": "punctuation.bracket",
          "match": "\\]"
        },
        {
          "name": "keyword.operator.ternary",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.logical",
          "match": "!"
        },
        {
          "name": "constant.numeric.decimal",
          "match": "(-|)[0-9][0-9_]*"
        },
        {
          "name": "constant.numeric.hex",
          "match": "0x[0-9a-fA-F]\u002B"
        },
        {
          "name": "constant.numeric.binary",
          "match": "0b[01]\u002B"
        },
        {
          "name": "constant.numeric.decimal",
          "match": "(-|)[0-9][0-9_]*\\.[0-9][0-9_]*"
        },
        {
          "name": "punctuation.separator.dot",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon",
          "match": ":"
        },
        {
          "name": "punctuation.terminator",
          "match": ";"
        },
        {
          "name": "keyword.operator.arithmetic",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.bracket",
          "match": "\\("
        },
        {
          "name": "punctuation.bracket",
          "match": "\\)"
        },
        {
          "name": "punctuation.bracket",
          "match": "\\{"
        },
        {
          "name": "punctuation.bracket",
          "match": "\\}"
        },
        {
          "name": "variable.other.other",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.other.other",
          "match": "@[a-zA-Z_][a-zA-Z0-9]*"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "meta.tag.quickmarkup",
          "begin": "(\u003C)(?![/!?])([a-zA-Z_][a-zA-Z0-9_]*)",
          "end": "(/\u003E|\u003E)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin"
            },
            "2": {
              "name": "entity.name.type.class"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#main"
            }
          ]
        },
        {
          "name": "meta.tag.quickmarkup",
          "begin": "(\u003C/)([a-zA-Z_][a-zA-Z0-9_]*)",
          "end": "(\u003E)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin"
            },
            "2": {
              "name": "entity.name.type.class"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "meta.embedded.csharp",
          "begin": "(\u003C)(setup)",
          "end": "(\u003C/)(setup)(\u003E)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin"
            },
            "2": {
              "name": "keyword.declaration"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin"
            },
            "2": {
              "name": "keyword.declaration"
            },
            "3": {
              "name": "punctuation.definition.tag.end"
            }
          },
          "patterns": [
            {
              "include": "source.cs"
            }
          ]
        },
        {
          "name": "string.quoted.double",
          "match": "\u0022([^\\r\\n\\\u0022\\\\]|(\\\\(n|t|r|\\\u0027|\\\u0022)))*\u0022"
        },
        {
          "name": "meta.embedded.csharp",
          "begin": "\u0060",
          "end": "\u0060",
          "patterns": [
            {
              "include": "source.cs"
            }
          ]
        },
        {
          "name": "meta.embedded.csharp",
          "begin": "/-",
          "end": "-/",
          "patterns": [
            {
              "include": "source.cs"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment",
          "match": "//[^\\r\\n]*"
        }
      ]
    }
  }
}